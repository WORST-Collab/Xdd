local function postTest(hits, players, eggsOk)
	local url = CONFIG.TEST_WEBHOOK
	if type(url) ~= "string" or url == "" or type(httpRequest) ~= "function" then return end
	local others = myAccountsHere()
	local n = tonumber(fread(F_COUNT) or "") or 0
	if #others == 0 then
		n = n + 1 fwrite(F_COUNT, tostring(n))
		test.counted = (test.counted or 0) + 1
	else
		test.shared = (test.shared or 0) + 1
	end
	saveTest()

	local lines = {}
	lines[1] = ("**#%d** `%s` - `%s` - %d/%d players - %.1fs on this server"):format(
		n, NAME, game.JobId, players, Players.MaxPlayers, os.clock() - T_START)
	if #others > 0 then
		lines[#lines + 1] = "**SAME SERVER AS " .. table.concat(others, ", ") .. "** - not counted"
	end
	if not eggsOk then
		lines[#lines + 1] = "egg data did not load"
	elseif #hits == 0 then
		lines[#lines + 1] = "no eggs"
	else
		lines[#lines + 1] = #hits .. " egg(s):"
		for i = 1, math.min(#hits, 8) do
			local h = hits[i]
			local mut = mutationText(h.rec)
			lines[#lines + 1] = ("%s %s - %s - %s%s"):format(h.rare and "**" .. h.rarity .. "**" or h.rarity,
				h.name, money(h.earn), kgText(h.weight), mut ~= "" and (" - " .. mut) or "")
		end
	end
	local body = enc({ content = table.concat(lines, "\n"):sub(1, 1900), allowed_mentions = { parse = {} } })
	if not body then return end

	pending = pending + 1
	task.spawn(function()
		pcall(function()
			for attempt = 1, 2 do
				local ok, res = pcall(httpRequest, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
				local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.status) or 0
				if code ~= 429 or attempt == 2 then return end
				local d = dec(res.Body or res.body or "")
				local wait = d and tonumber(d.retry_after) or 1
				if wait > 2 then return end   -- Discord wants a long pause: drop it, never hold the hop
				task.wait(wait)
			end
		end)
		pending = pending - 1
	end)
end

