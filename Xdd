local skipGap = false   -- the last join was refused (server gone): try the next one straight away
local function tryJoin(id)
	local gap = skipGap and 0 or (tonumber(CONFIG.MIN_JOIN_GAP) or 0)
	skipGap = false
	local since = os.time() - (tonumber(fread(F_JOIN) or "") or 0)
	if gap > 0 and since >= 0 and since < gap then task.wait(gap - since) end

	verdict = nil
	G.FAST_HOPPER_RUNNING = false
	queueReload()
	fwrite(F_JOIN, tostring(os.time()))
	fwrite(F_TP, tostring(nowMs()))
	saveHunt()
	local ok, err = pcall(function() TeleportService:TeleportToPlaceInstance(PLACE, id, lp) end)
	if not ok then
		G.FAST_HOPPER_RUNNING = true
		log("join error " .. tostring(err))
		bump("joinError") saveTest()
		return
	end
	local t = os.clock()
	while os.clock() - t < (tonumber(CONFIG.VERDICT) or 3) and not verdict do task.wait(0.1) end
	if verdict and not verdict:find("Failed") then
		log("joining " .. id:sub(1, 8))
		task.wait(tonumber(CONFIG.LEAVE_WAIT) or 8)
		log("accepted but never left " .. id:sub(1, 8))
		bump("neverLeft")
		addToSet(F_SDEAD, id, 300, 1800)
		refusedStreak = refusedStreak + 1
	else
		log("refused " .. id:sub(1, 8) .. " (" .. tostring(verdict or "no answer") .. ")")
		bump("refused")
		addToSet(F_SDEAD, id, 300, 1800)                    -- tell the other accounts here: do not try this one
		refusedStreak = refusedStreak + 1
		skipGap = true
	end
	saveTest()
	G.FAST_HOPPER_RUNNING = true
end

-- ------------------------------------------------------------------ eggs
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local pending = 0   -- relay sends still on their way

local function loadEggModules()
	local ok, a, e = pcall(function()
		local data   = ReplicatedStorage:WaitForChild("Data", 20)
		local client = ReplicatedStorage:WaitForChild("Client", 20)
		return require(data:WaitForChild("Assets", 20)), require(client:WaitForChild("EggState", 20))
	end)
	if ok and a and e then return a, e end
	log("egg modules not ready: " .. tostring(a))
	return nil, nil
end

local function liveRecords(eggState)
	local ok, data = pcall(eggState.ReadFieldEggs)
	if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then return nil end
	local out = {}
	for key, rec in pairs(data.Records) do
		if type(rec) == "table" then
			local st = rec.State
			if st == nil or tostring(st) == "Slot" or tostring(st) == "Dropped" then
				local r = {}
				for k, v in pairs(rec) do r[k] = v end
				if r.Uid == nil then r.Uid = tostring(key) end
				out[#out + 1] = r
			end
		end
	end
	return out
end

-- the egg list arrives from Roblox in batches: wait until the count stops changing
local function waitForEggs(eggState)
	local t0 = os.clock()
	local last, stable = nil, 0
	while os.clock() - t0 < (tonumber(CONFIG.EGG_MAX_WAIT) or 10) do
		local recs = liveRecords(eggState)
		if recs then
			if #recs > 0 then
				if #recs == last then
					stable = stable + 1
					if stable >= (tonumber(CONFIG.EGG_STABLE_READS) or 2) then return true end
				else
					last, stable = #recs, 0
				end
			elseif os.clock() - t0 >= (tonumber(CONFIG.EGG_EMPTY_WAIT) or 2) then
				return true
			end
		end
		task.wait(0.25)
	end
	return false
end

local MUTATION_SCALAR = {
	Silver = 1.2, Golden = 2.5, Rainbow = 3.5, Monstrous = 3, Boss = 2.75, Scrambled = 2.75, Enchanted = 2.85,
	Sakura = 1.25, GreatBloom = 2.5, Nitro = 2.75, Spectral = 2.75, Parasite = 3, Fractured = 2.75,
	Bloom = 1.25, SpiritBloom = 2.5,
}
local function scaleFactor(x)
	if x <= 5 then return x ^ 1.85 end
	return 5 ^ 1.85 * (x / 5) ^ 1.2
end
local function earning(cfg, rec)
	local base = cfg and tonumber(cfg.EarningRate) or 0
	if base <= 0 then return 0 end
	local scale = tonumber(rec.AssetScale) or 0
	if scale <= 0 then return base end
	local m = 1
	if type(rec.Mutations) == "table" then
		for _, mid in ipairs(rec.Mutations) do
			local x = MUTATION_SCALAR[tostring(mid)]
			if x then m = m + math.max(0, x - 1) end
		end
	end
	return math.max(math.round(base * scaleFactor(scale) * math.max(1, m)), 1)
end
local function rarityOf(cfg)
	local r = cfg and cfg.Rarity
	if type(r) == "table" then return r._id or r.id or r.Name end
	return r
end
local function mutationText(rec)
	if type(rec.Mutations) == "table" and #rec.Mutations > 0 then
		local p = {}
		for _, m in ipairs(rec.Mutations) do p[#p + 1] = tostring(m) end
		return table.concat(p, ", ")
	end
	return ""
end

local function scan(assets, eggState)
	local hits = {}
	local dir = assets.Directory
	for _, rec in ipairs(liveRecords(eggState) or {}) do
		local cfg = dir and dir[rec.AssetCategory]
		local rarity = rarityOf(cfg)
		if rarity then
			local w = cfg and tonumber(cfg.ModelWeight)
			hits[#hits + 1] = {
				rec = rec, rarity = tostring(rarity), rare = TARGET[tostring(rarity)] == true,
				name = tostring((cfg and (cfg.DisplayName or cfg._id)) or rec.AssetCategory),
				weight = w and w * math.max(tonumber(rec.AssetScale) or 0, 0) ^ 3 or nil,
				earn = earning(cfg, rec),
			}
		end
	end
	table.sort(hits, function(a, b)
		if a.rare ~= b.rare then return a.rare end
		return (a.earn or 0) > (b.earn or 0)
	end)
	return hits
end

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi" }
local function money(n)
	n = tonumber(n) or 0
	local i = 1
	while n >= 1000 and i < #SUFFIX do n = n / 1000 i = i + 1 end
	return ("$%.2f%s/s"):format(n, SUFFIX[i])
end
local function kgText(n)
	if not n then return "?" end
	local str = tostring(math.floor(n))
	local out = str:sub(1, (#str - 1) % 3 + 1)
	for j = (#str - 1) % 3 + 2, #str, 3 do out = out .. "," .. str:sub(j, j + 2) end
	return out .. " Kg"
end

local PV_AREAS = {
	cherryblossom = "Cherry Blossom", lightdark = "Light Dark", angelsdemons = "Light Dark",
	titantemple = "Titan Temple", enchantedforest = "Enchanted Forest",
	alien = "Alien", alienbiome = "Alien", alienworld = "Alien", alienlagoon = "Alien Lagoon",
}
local function pvZone(areaId)
	local k = (tostring(areaId or ""):lower():gsub("[^%w]", ""))
	if PV_AREAS[k] then return PV_AREAS[k] end
	if k:find("alien", 1, true) then return "Alien" end
	return nil
end

-- one egg -> the relay (same fields as the egg grabber, so the joiner, the site and PV all work)
local function publish(hit, players, seenMs, held)
	pending = pending + 1
	task.spawn(function()
		pcall(function()
			for attempt = 1, 2 do
				local code = relayPost("/publish", {
					placeId = tostring(PLACE), jobId = game.JobId, egg = hit.name, tier = hit.rarity,
					value = hit.earn or 0, kg = kgText(hit.weight), mutation = mutationText(hit.rec),
					players = players .. "/" .. tostring(Players.MaxPlayers), bot = NAME, held = held or nil,
					sent = nowMs(), seen = seenMs,
					-- the relay only forwards an egg to PV when it knows the area (pv_biome); leaving these
					-- out keeps the egg on the Joiner and the site only
					pv_id = CONFIG.SEND_TO_PV and ("G/" .. tostring(hit.rec.Uid or "")) or nil,
					pv_biome = CONFIG.SEND_TO_PV and pvZone(hit.rec.AreaId) or nil,
					pv_weight = CONFIG.SEND_TO_PV and tonumber(hit.weight) or nil,
					pv_scale = CONFIG.SEND_TO_PV and tonumber(hit.rec.AssetScale) or nil,
				}, 5)
				if code and code >= 200 and code < 300 then return end
				if code and code >= 400 and code < 500 and code ~= 429 then return end
				if attempt == 1 then task.wait(0.5) end
			end
		end)
		pending = pending - 1
	end)
end

-- ------------------------------------------------------------------ one landing: eggs -> relay -> owner hold
local function handleEggs(hits, players, seenMs)
	local sentN, others, cap, rares = 0, 0, tonumber(CONFIG.MAX_OTHER) or 10, {}

	-- OWNER HOLD: a 75B+ egg asks the relay whether this is the wave's held server
	local holding, holdNote = false, nil
	do
		local top = 0
		for _, h in ipairs(hits) do top = math.max(top, tonumber(h.earn) or 0) end
		if top >= (tonumber(CONFIG.HOLD_MIN_VALUE) or 75e9) then
			if players >= Players.MaxPlayers then
				holdNote = "75B+ egg but the server is full - not held"
			else
				local code, body = relayPost("/hold", { bot = NAME, id = game.JobId, value = top }, 2.5)
				local d = code == 200 and dec(body or "")
				holding = type(d) == "table" and d.held == true
				holdNote = holding and "HELD" or ("75B+ egg, not held (" .. tostring(type(d) == "table" and d.reason or "relay did not answer") .. ")")
			end
			log(holdNote)
		end
	end

	for _, h in ipairs(hits) do
		if h.rare then
			publish(h, players, seenMs, holding)
			sentN = sentN + 1
			local mut = mutationText(h.rec)
			rares[#rares + 1] = ("**%s** %s - %s - %s%s"):format(h.rarity, h.name, money(h.earn), kgText(h.weight), mut ~= "" and (" - " .. mut) or "")
		elseif not CONFIG.ONLY_RARE and (cap <= 0 or others < cap) then
			others = others + 1
			publish(h, players, seenMs, holding)
			sentN = sentN + 1
		end
	end
	local tw = os.clock()
	while pending > 0 and os.clock() - tw < 3 do task.wait(0.03) end

	-- OWNER HOLD: wait for that account; it joining = leave now, the eggs are never sent to anyone else
	if holding then
		local owner = tonumber(CONFIG.OWNER_USER_ID) or 0
		local t0, joined = os.clock(), false
		while os.clock() - t0 < (tonumber(CONFIG.HOLD_SECS) or 30) and not stopped() do
			if Players:GetPlayerByUserId(owner) then joined = true break end
			task.wait(0.25)
		end
		local waited = os.clock() - t0
		pcall(relayPost, "/hold/done", { bot = NAME, id = game.JobId, joined = joined }, 5)
		bump(joined and "holdJoined" or "holdReleased") saveTest()
		holdNote = joined and ("HELD - owner joined after %.0fs - eggs NOT sent, leaving"):format(waited)
			or ("HELD %.0fs - owner did not join - eggs sent to everyone"):format(waited)
		log(holdNote)
	end
	return sentN, rares, holdNote
end

-- ------------------------------------------------------------------ rare-egg rule
local function hasRare(hits)
	for _, h in ipairs(hits) do if h.rare then return true end end
	return false
end
local function rareUids(hits)
	local set = {}
	for _, h in ipairs(hits) do if h.rare then set[tostring(h.rec.Uid)] = true end end
	return set
end
-- stay in this server until a rare egg that is not in `known` shows up. true = one did, false = stopped.
local function waitForNewRare(assets, eggState, known)
	log("staying in this server - waiting for a new rare egg")
	local lastAlive = 0
	while not stopped() do
		if os.time() - lastAlive >= 5 then saveHunt() lastAlive = os.time() end
		for _, h in ipairs(scan(assets, eggState)) do
			if h.rare and not known[tostring(h.rec.Uid)] then return true end
		end
		task.wait(tonumber(CONFIG.WAIT_POLL) or 1)
	end
	return false
end

-- ------------------------------------------------------------------ main
local function main()
	while not game:IsLoaded() do task.wait(0.05) end
	local loadedMs, loadedAt = nowMs(), os.clock()
	local tpMs = tonumber(fread(F_TP) or "")
	local loading = (tpMs and loadedMs - tpMs > 0 and loadedMs - tpMs < 180000) and (loadedMs - tpMs) / 1000 or nil
	fwrite(F_TP, "")
	bump("landed")
	if loading then bump("loadingSum", loading) bump("loadingN") end
	saveTest()
	log(("landed %s (%d/%d)%s"):format(game.JobId:sub(1, 8), #Players:GetPlayers(), Players.MaxPlayers,
		loading and (" - loading took %.1fs"):format(loading) or ""))
	-- the relay answers with your other bots already in this server + the names of all your online bots
	task.spawn(function()
		local code, body = relayPost("/landed", { bot = NAME, id = game.JobId }, 5)
		local d = code == 200 and dec(body or "")
		if type(d) ~= "table" then return end
		for _, n in ipairs(type(d.bots) == "table" and d.bots or {}) do
			if tostring(n):lower() ~= NAME:lower() then MINE[tostring(n):lower()] = true end
		end
		for _, n in ipairs(type(d.others) == "table" and d.others or {}) do seenMine[tostring(n)] = true end
		noteMyAccounts()
	end)
	noteMyAccounts()

	local huntLen = tonumber(CONFIG.HUNT_SECS) or 260
	local function huntLeft() return (tonumber(hunt.huntEnd) or 0) - os.time() end

	-- next server: claimed in the background while the eggs load - but only while this account is hopping,
	-- so an account that is waiting never reserves servers it will not join
	local id, prepDone, prepStarted = nil, false, false
	local function startPrep()
		if prepStarted then return end
		prepStarted = true
		task.spawn(function()
			local ok, r = pcall(nextClaimed)
			id = ok and r or nil
			prepDone = true
		end)
	end
	local function startHunt(why)
		hunt.huntEnd = os.time() + huntLen
		saveHunt()
		log(("%s - hopping for the next %ds"):format(why, huntLen))
		startPrep()
	end
	if huntLeft() > 0 then startPrep() end

	-- eggs
	local eggT = os.clock()
	local hits = {}
	local assets, eggState = loadEggModules()
	if assets then
		waitForEggs(eggState)
		hits = scan(assets, eggState)
	end
	local eggSecs = os.clock() - eggT
	bump("eggSum", eggSecs)
	local players, seenMs = #Players:GetPlayers(), nowMs()

	-- RULE: the script was just started and a rare egg is here -> start the hunt window.
	-- (If a window already ran, the rare eggs in this server are old news: only a NEW one starts the next window.)
	local hadHunt = (tonumber(hunt.huntEnd) or 0) > 0
	if huntLeft() <= 0 and assets and not hadHunt and hasRare(hits) then startHunt("rare egg found") end

	local sentN, rares, holdNote = handleEggs(hits, players, seenMs)
	local known = rareUids(hits)
	local mustHop = (assets == nil)   -- cannot read eggs here: keep hopping like before
	local reported = false

	-- the proof-of-hop line + test summary (once per server, just before leaving it). true = test over
	local function report()
		local stayed = os.clock() - loadedAt
		bump("staySum", stayed)
		noteMyAccounts()
		local mine = {}
		for n in pairs(seenMine) do mine[#mine + 1] = n end
		if #mine == 0 then bump("alone") else bump("shared") end
		saveTest()
		local line = ("**Hop %d** `%s` - `%s` - %d/%d players - loading %s - egg data %.1fs - stayed %.1fs - %d eggs (%d sent) - %s"):format(
			test.landed, NAME, game.JobId, players, Players.MaxPlayers,
			loading and ("%.1fs"):format(loading) or "n/a (first server)", eggSecs, stayed, #hits, sentN,
			#mine == 0 and "alone" or ("**SAME SERVER AS " .. table.concat(mine, ", ") .. "**"))
		if holdNote then line = line .. "\n**" .. holdNote .. "**" end
		if #rares > 0 then line = line .. "\n" .. table.concat(rares, "\n") end
		webhook({ allowed_mentions = { parse = {} }, content = line:sub(1, 1900) }, 2)

		if testOver() then
			test.done = true
			saveTest()
			local secs = os.time() - test.start
			local landed = math.max(1, tonumber(test.landed) or 1)
			local function n(k) return tostring(tonumber(test[k]) or 0) end
			local function f(name, value) return { name = name, value = value, inline = true } end
			webhook({ allowed_mentions = { parse = {} }, embeds = { {
				title = "TEST DONE - " .. NAME,
				color = (tonumber(test.shared) or 0) > 0 and 0xFFB020 or 0x37D67A,
				description = ("**%d servers** in %d:%02d - about **%.1fs per server**"):format(landed, math.floor(secs / 60), secs % 60, secs / landed),
				fields = {
					f("Alone", n("alone")),
					f("Shared with my accounts", n("shared")),
					f("Avg loading screen", ("%.1fs"):format((tonumber(test.loadingSum) or 0) / math.max(1, tonumber(test.loadingN) or 0))),
					f("Avg stay", ("%.1fs"):format((tonumber(test.staySum) or 0) / landed)),
					f("Avg egg data", ("%.1fs"):format((tonumber(test.eggSum) or 0) / landed)),
					f("Joins refused", n("refused")),
					f("Accepted but never left", n("neverLeft")),
					f("Join errors", n("joinError")),
					f("Server list downloads", n("listFetch")),
					f("Server list 429s", n("list429")),
					f("Waited for a free server", n("noServerWaits") .. " x 2s"),
					f("Relay said taken", n("denied")),
					f("Relay no answer", n("relayMiss")),
				},
				footer = { text = "Loading = from the teleport starting to the next server being loaded" },
			} } }, 5)
			log("test over - staying in this server")
			finished = true
			return true
		end
		return false
	end

	-- hop while the hunt window is open, otherwise stay here and wait for a new rare egg
	while not stopped() do
		if not (mustHop or huntLeft() > 0) then
			if waitForNewRare(assets, eggState, known) then
				waitForEggs(eggState)                       -- let the rest of the new eggs arrive
				hits = scan(assets, eggState)
				startHunt("new rare egg spawned")
				players, seenMs = #Players:GetPlayers(), nowMs()
				sentN, rares, holdNote = handleEggs(hits, players, seenMs)
				known = rareUids(hits)
			end
		else
			startPrep()
			while not prepDone do task.wait(0.03) end
			if not game:IsLoaded() then
				log("not in a game - waiting")
				task.wait(3)
			else
				if not id then id = nextClaimed() end
				if not id then
					bump("noServerWaits") saveTest()
					log("no free server right now - retrying in 2s")
					task.wait(2)
					noteMyAccounts()
				else
					if not reported then
						reported = true
						if report() then return end
					end
					tryJoin(id)
					addToSet(F_FAILED, id, 60, 3600)
					id = nil
					task.wait(skipGap and 0.1 or 0.5)
				end
			end
		end
	end
end

task.spawn(function()
	while not stopped() do
		local ok, err = pcall(main)
		if not ok then log("error: " .. tostring(err) .. " - restarting in 5s") task.wait(5) end
	end
	G.FAST_HOPPER_RUNNING = false
end)
