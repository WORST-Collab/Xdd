-- ------------------------------------------------------------------ webhook
local function webhook(payload, maxWait)
	local url = CONFIG.TEST_WEBHOOK
	if type(url) ~= "string" or url == "" or type(httpRequest) ~= "function" then return end
	local body = enc(payload)
	if not body then return end
	local done = false
	task.spawn(function()
		for attempt = 1, 2 do
			local ok, res = pcall(httpRequest, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
			local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.status) or 0
			if code ~= 429 or attempt == 2 then break end
			local d = dec(res.Body or res.body or "")
			local w = d and tonumber(d.retry_after) or 1
			if w > 2 then break end
			task.wait(w)
		end
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < (maxWait or 2) do task.wait(0.03) end
end

