local F_SBLOCK  = "fast-hopper-shared-block.txt"            -- Roblox said 429: nobody asks before this time
local F_SFETCH  = "fast-hopper-shared-fetching.txt"         -- someone is downloading right now
local F_SDEAD   = "fast-hopper-shared-dead.txt"             -- servers Roblox refused (closed / full): nobody tries them again

local function readSet(file, maxAge)
	local set, list, now = {}, {}, os.time()
	for line in (fread(file) or ""):gmatch("[^\r\n]+") do
		local id, ts = line:match("^(%S+)%s+(%d+)$")
		if id and (not maxAge or now - tonumber(ts) < maxAge) then set[id] = true list[#list + 1] = line end
	end
	return set, list
end
local function addToSet(file, id, keep, maxAge)
	local _, list = readSet(file, maxAge)
	local out = {}
	for _, line in ipairs(list) do if not line:find(id, 1, true) then out[#out + 1] = line end end
	out[#out + 1] = id .. " " .. os.time()
	while #out > keep do table.remove(out, 1) end
	fwrite(file, table.concat(out, "\n"))
end
