	local clear = clear_teleport_queue or clearteleportqueue or (syn and syn.clear_teleport_queue)
	if type(clear) == "function" then pcall(clear) end
	local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
	if type(q) ~= "function" then return end
	local boot = ([==[
