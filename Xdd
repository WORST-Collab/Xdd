--[[
	FAST HOPPER (standalone) - owner hold, no time limit, no webhook, Joiner + site only
	land -> read the eggs -> send them to the relay -> hop. The next server is claimed WHILE the eggs load.

	RARE-EGG RULE (per account):
	  - started and a Secret/Eternal/Divine egg is in the server -> hop for HUNT_SECS (260s = 4:20),
	    then stay in whatever server it is in and wait for a NEW rare egg to spawn there
	  - started and no rare egg -> stay in the server and wait for a rare egg to spawn
	  - a rare egg spawning while it waits starts the next HUNT_SECS of hopping
	  Rare eggs found while hopping do NOT extend the window. The owner hold works in every server.

	FEWER 429s: the accounts on one PC share ONE server list (a file in the executor's workspace).
	One account downloads a page, the others reuse it for SHARED_LIST_TTL seconds, and when Roblox
	answers 429 every account backs off together instead of all asking again.

	NO SHARED SERVERS: each server is claimed from the relay first (one account per 5-minute wave).
	If the relay does not answer, the account does NOT join.

	SETUP: save this file as  fast-hopper.lua  in your executor's workspace folder.
	RUN:   loadstring(readfile("fast-hopper.lua"))()
	       After every hop it reloads itself from that same workspace file (SCRIPT_URL is empty on purpose).
	       If you host the file online instead, put the link in SCRIPT_URL and run it with HttpGet.
	STOP:  getgenv().FAST_HOPPER_STOP = true    or put "1" in fast-hopper-stop.txt
]]

local CONFIG = {
	SCRIPT_URL       = "",     -- empty = reload from the workspace file SELF_FILE after each hop
	SELF_FILE        = "fast-hopper.lua",

	HUB_URL          = "http://103.119.217.118:3000/publish",   -- your relay
	HUB_KEY          = "5e1b336915a75fab",

	TEST_WEBHOOK     = "",     -- blank = no Discord posts
	ACCOUNTS         = {},     -- optional extra names. Not needed: the relay tells each bot the names of all your online bots

	MIN_JOIN_GAP     = 2,      -- seconds between two join attempts (Roblox flood guard)
	VERDICT          = 3,      -- seconds to wait for Roblox to accept a join
	LEAVE_WAIT       = 8,      -- seconds an accepted join gets to actually leave
	LIST_MAX_PLAYING = 5,      -- only servers listed with at most this many players
	LIST_PING_SKIP   = 110,    -- servers listed above this ping are tried last
	SHARED_LIST_TTL  = 20,     -- seconds the accounts reuse one downloaded page before fetching the next
	FPS_CAP          = 10,     -- 0 = leave Roblox's FPS alone
	TEST_MINUTES     = 0,      -- 0 = run forever
	HUNT_SECS        = 260,    -- after a rare egg is found: hop for this long (4:20), then stay and wait for the next one
	WAIT_POLL        = 1,      -- seconds between egg checks while staying in a server

	OWNER_USER_ID    = 8217478439,   -- OWNER HOLD: the account the first 75B+ server of each wave is held for
	HOLD_MIN_VALUE   = 75e9,         -- an egg worth at least this per second asks the relay for the hold
	HOLD_SECS        = 30,           -- how long the bot waits in a held server for that account
	SEND_TO_PV       = false,  -- false = eggs go to the Joiner + site only, never to PV
	ONLY_RARE        = false,  -- true = send ONLY Secret/Eternal/Divine to the relay (Cosmic then never reaches PV)
	MAX_OTHER        = 10,     -- eggs below Secret sent to the relay per server, best first (0 = all)
	EGG_STABLE_READS = 2,      -- egg count must stay the same this many reads, 0.25s apart
	EGG_EMPTY_WAIT   = 2,      -- seconds to wait when the egg list stays empty
