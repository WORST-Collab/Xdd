-- normally never returns after a good join: the client leaves and this script ends with it
local function tryJoin(id)
	local gap = tonumber(CONFIG.MIN_JOIN_GAP) or 0
	local since = os.time() - (tonumber(fread(F_JOIN) or "") or 0)
	if gap > 0 and since >= 0 and since < gap then task.wait(gap - since) end

	verdict = nil
	G.FAST_HOPPER_RUNNING = false   -- let the copy queued for the next server start
	queueReload()
	fwrite(F_JOIN, tostring(os.time()))
	local ok, err = pcall(function() TeleportService:TeleportToPlaceInstance(PLACE, id, lp) end)
	if not ok then
		G.FAST_HOPPER_RUNNING = true
		log("join error " .. tostring(err))
		return
	end
	local t = os.clock()
	while os.clock() - t < (tonumber(CONFIG.VERDICT) or 3) and not verdict do task.wait(0.1) end
	if verdict and not verdict:find("Failed") then
		log("joining " .. id:sub(1, 8))
		task.wait(tonumber(CONFIG.LEAVE_WAIT) or 8)
		log("accepted but never left " .. id:sub(1, 8))
	else
		log("refused " .. id:sub(1, 8) .. " (" .. tostring(verdict or "no answer") .. ")")
	end
	G.FAST_HOPPER_RUNNING = true
end

-- ------------------------------------------------------------------ main
local function main()
	local t = os.clock()
	while not game:IsLoaded() and os.clock() - t < 30 do task.wait(0.1) end
	log(("landed %s (%d/%d)"):format(game.JobId:sub(1, 8), #Players:GetPlayers(), Players.MaxPlayers))
	hbStatus = "Scanning"
	test.landed = (test.landed or 0) + 1
	saveTest()
	task.spawn(function() pcall(relayPost, "/landed", { bot = NAME, id = game.JobId }, 5) end)

	-- 1) find + claim the next server in the background, while the eggs load
	local nextId, prepDone = nil, false
	task.spawn(function()
		local ok, id = pcall(nextClaimed)
		nextId = ok and id or nil
		prepDone = true
	end)

	-- 2) eggs
	local hits, eggsOk = {}, false
	local assets, eggState = loadEggModules()
	if assets then
		waitForEggs(eggState)
		hits = scan(assets, eggState)
		eggsOk = true
	end
	local players, seenMs = #Players:GetPlayers(), nowMs()

	-- 3) send: every Secret/Eternal/Divine + the best MAX_OTHER of the rest, then the test webhook
	local others, cap = 0, tonumber(CONFIG.MAX_OTHER) or 10
	for _, h in ipairs(hits) do
		if h.rare then publish(h, players, seenMs)
		elseif cap <= 0 or others < cap then others = others + 1 publish(h, players, seenMs) end
	end
	postTest(hits, players, eggsOk)
	t = os.clock()
	while pending > 0 and os.clock() - t < (tonumber(CONFIG.SEND_WAIT) or 3) do task.wait(0.03) end
	log(("sent %d egg(s) in %.1fs"):format(#hits, os.clock() - T_START))

	-- test over? post the summary and stop here instead of hopping
	if testOver() then
		test.done = true
		saveTest()
		local secs = os.time() - test.start
		local body = enc({ allowed_mentions = { parse = {} }, content = ("**TEST DONE** `%s` - %d servers in %d:%02d - %d counted, %d shared with my accounts - about %.1fs per server"):format(
			NAME, test.landed or 0, math.floor(secs / 60), secs % 60, test.counted or 0, test.shared or 0, secs / math.max(1, test.landed or 1)) })
		if body and type(httpRequest) == "function" and CONFIG.TEST_WEBHOOK ~= "" then
			pcall(httpRequest, { Url = CONFIG.TEST_WEBHOOK, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
		end
		log("test over - staying in this server")
		finished = true
		hbStatus = "Test done"
		return
	end

	-- 4) hop
	hbStatus = "Hopping"
	task.spawn(function() pcall(relayPost, "/beat", { name = NAME, status = "Hopping", eggs = 0 }, 5) end)
	while not prepDone do task.wait(0.03) end
	local id = nextId
	while not stopped() do
		if not game:IsLoaded() then              -- error screen: never teleport from here, wait for the rejoin
			log("not in a game - waiting")
			task.wait(3)
		else
			if not id then id = nextClaimed() end
			if not id then
				log("no free server right now - retrying in 2s")
				task.wait(2)
			else
				tryJoin(id)
				addToSet(F_FAILED, id, 60, 3600)
				id = nil
				task.wait(0.5)
			end
		end
	end
	log("stopped")
end

task.spawn(function()
	while not stopped() do
		local ok, err = pcall(main)
		if not ok then log("error: " .. tostring(err) .. " - restarting in 5s") task.wait(5) end
	end
	G.FAST_HOPPER_RUNNING = false
end)
