local verdict = nil
lp.OnTeleport:Connect(function(state) verdict = tostring(state) end)
pcall(function()
	TeleportService.TeleportInitFailed:Connect(function(p, result) if p == lp then verdict = "Failed " .. tostring(result) end end)
