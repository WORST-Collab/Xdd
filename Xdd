-- ------------------------------------------------------------------ timed test
-- Every start (after a hop, a crash, AutoExec) carries on with the SAME test. A new test starts when
-- getgenv().FAST_HOPPER_NEWTEST is set to a name different from the last one, or when the last test
-- began more than TEST_MINUTES + 10 minutes ago.
local TEST_MIN = tonumber(CONFIG.TEST_MINUTES) or 0
local test = dec(fread(F_TEST) or "") or {}
local testName = G.FAST_HOPPER_NEWTEST ~= nil and tostring(G.FAST_HOPPER_NEWTEST) or nil
G.FAST_HOPPER_NEWTEST = nil
if (testName and testName ~= test.name) or not tonumber(test.start) or os.time() - test.start >= TEST_MIN * 60 + 600 then
	test = { name = testName or test.name, start = os.time(), done = false }
	fwrite(F_TP, "")   -- the first server of a test has no teleport to measure
end
local function saveTest() fwrite(F_TEST, enc(test) or "") end
local function bump(k, n) test[k] = (tonumber(test[k]) or 0) + (n or 1) end
local function testOver() return TEST_MIN > 0 and os.time() - test.start >= TEST_MIN * 60 end
if TEST_MIN > 0 and test.done then
	G.FAST_HOPPER_RUNNING = false
	print("[fast-hopper] this test is over - set getgenv().FAST_HOPPER_NEWTEST to a new name to start another")
	return
end

-- ------------------------------------------------------------------ relay (claims only)
local RELAY = (tostring(CONFIG.HUB_URL):gsub("/publish/?$", ""))

local function relayPost(path, data, maxWait)
	if type(httpRequest) ~= "function" then return nil end
	local body = enc(data)
	if not body then return nil end
	local done, code, out = false, nil, nil
	task.spawn(function()
		local ok, res = pcall(httpRequest, {
			Url = RELAY .. path, Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["x-key"] = CONFIG.HUB_KEY },
			Body = body,
		})
		if ok and type(res) == "table" then code = tonumber(res.StatusCode or res.status) out = res.Body or res.body end
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < (maxWait or 5) do task.wait(0.03) end
	if not done then return nil end
	return code, out
end

local relayMisses = 0
local function claim(id)
	local code, body = relayPost("/claim", { bot = NAME, id = id }, 2.5)
	local d = code == 200 and dec(body or "")
	if type(d) == "table" and type(d.granted) == "boolean" then
		relayMisses = 0
		if not d.granted then bump("denied") end
		return d.granted
	end
	bump("relayMiss")
	relayMisses = relayMisses + 1
	log("relay did not answer the claim - not joining " .. id:sub(1, 8))
	if relayMisses >= 3 then task.wait(3) end
	return false
end

-- ------------------------------------------------------------------ shared server list
local LIST_URL = "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"

local function readShared()
	local t = dec(fread(F_SLIST) or "")
	if t and tonumber(t.ts) and type(t.data) == "table" then return t.data, os.time() - t.ts end
	return nil, math.huge
end

-- download the NEXT page (shared cursor). Returns the list, or nil when blocked / failed.
local function downloadPage()
	local blockUntil = tonumber(fread(F_SBLOCK) or "") or 0
	if os.time() < blockUntil then return nil end
	local fetching = tonumber(fread(F_SFETCH) or "") or 0
	if os.time() - fetching < 3 then                 -- another account is downloading: wait for its result
		task.wait(1)
		local data, age = readShared()
		if data and age <= 3 then return data end
	end
	fwrite(F_SFETCH, tostring(os.time()))
	local cursor = fread(F_SCURSOR) or ""
	local url = LIST_URL:format(PLACE) .. (cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or "")
	local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
	local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.status) or 0
	fwrite(F_SFETCH, "0")
	if code == 200 then
		local page = dec(res.Body or res.body or "")
		if page and type(page.data) == "table" then
			fwrite(F_SCURSOR, type(page.nextPageCursor) == "string" and page.nextPageCursor or "")
			fwrite(F_SLIST, enc({ ts = os.time(), data = page.data }) or "")
			bump("listFetch")
			return page.data
		end
	elseif code == 429 then
		bump("list429")
		local wait = 10
		local h = type(res) == "table" and res.Headers
		local ra = h and tonumber(h["Retry-After"] or h["retry-after"])
		if ra and ra > 0 then wait = math.min(ra, 60) end
		fwrite(F_SBLOCK, tostring(os.time() + wait))
		log(("server list 429 - all accounts wait %ds"):format(wait))
	else
		fwrite(F_SCURSOR, "")                            -- an old cursor can expire: back to page 1
	end
	return nil
end

local function filterList(data)
	local visited = readSet(F_VISITED, 3600)
	local failed  = readSet(F_FAILED, 3600)
	local dead    = readSet(F_SDEAD, 1800)
	local good, laggy = {}, {}
	for _, s in ipairs(data or {}) do
		if type(s.id) == "string" and type(s.playing) == "number" and s.id ~= game.JobId
			and s.playing < (s.maxPlayers or 7) and s.playing <= (tonumber(CONFIG.LIST_MAX_PLAYING) or 5)
			and not visited[s.id] and not failed[s.id] and not dead[s.id] then
			local p = tonumber(s.ping)
			-- tried last: laggy servers, and servers listed with 0-1 players (most likely to have just closed)
			if (p and p > (tonumber(CONFIG.LIST_PING_SKIP) or 110)) or s.playing < 2 then laggy[#laggy + 1] = s else good[#good + 1] = s end
		end
	end
	for _, t in ipairs({ good, laggy }) do
		for i = #t, 2, -1 do local j = math.random(i) t[i], t[j] = t[j], t[i] end
	end
	for _, s in ipairs(laggy) do good[#good + 1] = s end
	return good
end

-- the shared list if it is fresh, otherwise the next page. Falls back to a shared list at most 60s old
-- (older lists are full of closed servers: Roblox error 771). force = skip the fresh-list reuse.
local function candidates(force)
	local data, age = readShared()
	if not force and data and age <= (tonumber(CONFIG.SHARED_LIST_TTL) or 20) then
		local c = filterList(data)
		if #c > 0 then return c end
	end
	local fresh = downloadPage()
	if fresh then
		local c = filterList(fresh)
		if #c > 0 then return c end
		fwrite(F_SCURSOR, "")                            -- nothing usable on that page (too deep / too full)
		return {}
	end
	if data and age <= 60 then return filterList(data) end
	return {}
end

-- the queue is rebuilt once it is older than SHARED_LIST_TTL, and right away after 3 refused joins in a row
local queue, qi, queueAt, refusedStreak = {}, 0, 0, 0
local function nextClaimed()
	local refills = 0
	while not stopped() do
		qi = qi + 1
		local s = queue[qi]
		local stale = os.clock() - queueAt > (tonumber(CONFIG.SHARED_LIST_TTL) or 20)
		if not s or stale or refusedStreak >= 3 then
			refills = refills + 1
			if refills > 3 then return nil end
			local force = refusedStreak >= 3
			if force then log("3 refused joins in a row - getting a fresh server list") end
			refusedStreak = 0
			queue, qi, queueAt = candidates(force), 0, os.clock()
		elseif claim(s.id) then
			return s.id
		end
	end
	return nil
end

