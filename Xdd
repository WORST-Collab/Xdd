-- ------------------------------------------------------------------ Roblox server list
-- One page per fetch. The cursor is saved per account, so each fetch reads the NEXT page instead of
-- all accounts fighting over the same 100 servers (and it halves the list requests).
local LIST_URL = "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"

local function fetchPage(fromStart)
	local cursor = fromStart and "" or (fread(F_CURSOR) or "")
	for _ = 1, 2 do
		local url = LIST_URL:format(PLACE) .. (cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or "")
		local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
		local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.status) or 0
		if code == 200 then
			local page = dec(res.Body or res.body or "")
			if page and type(page.data) == "table" then
				fwrite(F_CURSOR, type(page.nextPageCursor) == "string" and page.nextPageCursor or "")
				fwrite(F_LIST, os.time() .. "\n" .. (enc({ data = page.data }) or ""))
				return page.data
			end
		elseif code == 429 then
			local c = fread(F_LIST)
			local ts, body = c and c:match("^(%d+)\r?\n(.*)$")
			if ts and os.time() - tonumber(ts) <= 120 then
				log("server list 429 - using this account's last list")
				local t = dec(body)
				return t and t.data or nil
			end
			log("server list 429 - waiting 3s")
			task.wait(3)
		else
			cursor = ""                       -- an old cursor can expire: start from page 1
		end
	end
	return nil
end

local function candidates()
	local visited = readSet(F_VISITED, 3600)
	local failed  = readSet(F_FAILED, 3600)
	for pass = 1, 2 do
		local data = fetchPage(pass == 2) or {}
		local good, laggy = {}, {}
		for _, s in ipairs(data) do
			if type(s.id) == "string" and type(s.playing) == "number" and s.id ~= game.JobId
				and s.playing < (s.maxPlayers or 7) and s.playing <= (tonumber(CONFIG.LIST_MAX_PLAYING) or 5)
				and not visited[s.id] and not failed[s.id] then
				local p = tonumber(s.ping)
				if p and p > (tonumber(CONFIG.LIST_PING_SKIP) or 110) then laggy[#laggy + 1] = s else good[#good + 1] = s end
			end
		end
		if #good + #laggy > 0 then
			for _, t in ipairs({ good, laggy }) do
				for i = #t, 2, -1 do local j = math.random(i) t[i], t[j] = t[j], t[i] end
			end
			for _, s in ipairs(laggy) do good[#good + 1] = s end
			return good
		end
		fwrite(F_CURSOR, "")   -- this page had nothing usable (too deep / too full): back to page 1
	end
	return {}
end

-- walks the candidate list until the relay grants one. Returns its id, or nil.
local queue, qi = {}, 0
local function nextClaimed()
	local refills = 0
	while not stopped() do
		qi = qi + 1
		local s = queue[qi]
		if not s then
			refills = refills + 1
			if refills > 2 then return nil end
			queue, qi = candidates(), 0
		elseif claim(s.id) then
			return s.id
		end
	end
	return nil
end

