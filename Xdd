local function liveRecords(eggState)
	local ok, data = pcall(eggState.ReadFieldEggs)
	if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then return nil end
	local out = {}
	for key, rec in pairs(data.Records) do
		if type(rec) == "table" then
			local st = rec.State
			if st == nil or tostring(st) == "Slot" or tostring(st) == "Dropped" then
				local r = {}
				for k, v in pairs(rec) do r[k] = v end
				if r.Uid == nil then r.Uid = tostring(key) end
				out[#out + 1] = r
			end
		end
	end
	return out
end

local function waitForEggs(eggState)
	local t0 = os.clock()
	local last, stable = nil, 0
	while os.clock() - t0 < (tonumber(CONFIG.EGG_MAX_WAIT) or 15) do
		local recs = liveRecords(eggState)
		if recs then
			if #recs > 0 then
				if #recs == last then
					stable = stable + 1
					if stable >= (tonumber(CONFIG.EGG_STABLE_READS) or 4) then return true end
				else
					last, stable = #recs, 0
				end
			elseif os.clock() - t0 >= (tonumber(CONFIG.EGG_EMPTY_WAIT) or 3) then
				return true
			end
		end
		task.wait(0.25)
	end
	return false
end

-- earnings, same maths as the game (and the egg grabber)
local MUTATION_SCALAR = {
	Silver = 1.2, Golden = 2.5, Rainbow = 3.5, Monstrous = 3, Boss = 2.75, Scrambled = 2.75, Enchanted = 2.85,
	Sakura = 1.25, GreatBloom = 2.5, Nitro = 2.75, Spectral = 2.75, Parasite = 3, Fractured = 2.75,
	Bloom = 1.25, SpiritBloom = 2.5,
}
local function scaleFactor(s)
	if s <= 5 then return s ^ 1.85 end
	return 5 ^ 1.85 * (s / 5) ^ 1.2
end
local function earning(cfg, rec)
	local base = cfg and tonumber(cfg.EarningRate) or 0
	if base <= 0 then return 0 end
	local scale = tonumber(rec.AssetScale) or 0
	if scale <= 0 then return base end
	local m = 1
	if type(rec.Mutations) == "table" then
		for _, id in ipairs(rec.Mutations) do
			local x = MUTATION_SCALAR[tostring(id)]
			if x then m = m + math.max(0, x - 1) end
		end
	end
	return math.max(math.round(base * scaleFactor(scale) * math.max(1, m)), 1)
end
local function rarityOf(cfg)
	local r = cfg and cfg.Rarity
	if type(r) == "table" then return r._id or r.id or r.Name end
	return r
end
local function mutationText(rec)
	if type(rec.Mutations) == "table" and #rec.Mutations > 0 then
		local p = {}
		for _, m in ipairs(rec.Mutations) do p[#p + 1] = tostring(m) end
		return table.concat(p, ", ")
	end
	return ""
end

local function scan(assets, eggState)
	local hits = {}
	local dir = assets.Directory
	for _, rec in ipairs(liveRecords(eggState) or {}) do
		local cfg = dir and dir[rec.AssetCategory]
		local rarity = rarityOf(cfg)
		if rarity then
			local w = cfg and tonumber(cfg.ModelWeight)
			hits[#hits + 1] = {
				rec = rec, rarity = tostring(rarity), rare = TARGET[tostring(rarity)] == true,
				name = tostring((cfg and (cfg.DisplayName or cfg._id)) or rec.AssetCategory),
				weight = w and w * math.max(tonumber(rec.AssetScale) or 0, 0) ^ 3 or nil,
				earn = earning(cfg, rec),
			}
		end
	end
	table.sort(hits, function(a, b)
		if a.rare ~= b.rare then return a.rare end
		return (a.earn or 0) > (b.earn or 0)
	end)
	return hits
end

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi" }
local function money(n)
	n = tonumber(n) or 0
	local i = 1
	while n >= 1000 and i < #SUFFIX do n = n / 1000 i = i + 1 end
	return ("$%.2f%s/s"):format(n, SUFFIX[i])
end
local function kgText(n)
	if not n then return "?" end
	local s = tostring(math.floor(n))
	local out = s:sub(1, (#s - 1) % 3 + 1)
	for j = (#s - 1) % 3 + 2, #s, 3 do out = out .. "," .. s:sub(j, j + 2) end
	return out .. " Kg"
end

local PV_AREAS = {
	cherryblossom = "Cherry Blossom", lightdark = "Light Dark", angelsdemons = "Light Dark",
	titantemple = "Titan Temple", enchantedforest = "Enchanted Forest",
	alien = "Alien", alienbiome = "Alien", alienworld = "Alien", alienlagoon = "Alien Lagoon",
}
local function pvZone(areaId)
	local k = (tostring(areaId or ""):lower():gsub("[^%w]", ""))
	if PV_AREAS[k] then return PV_AREAS[k] end
	if k:find("alien", 1, true) then return "Alien" end
	return nil
end

-- one egg -> the relay (same fields the egg grabber sends, so the joiner, site and PV all work)
local function publish(hit, players, seenMs)
	pending = pending + 1
	task.spawn(function()
		pcall(function()
			for attempt = 1, 2 do
				local code = relayPost("/publish", {
					placeId = tostring(PLACE), jobId = game.JobId, egg = hit.name, tier = hit.rarity,
					value = hit.earn or 0, kg = kgText(hit.weight), mutation = mutationText(hit.rec),
					players = players .. "/" .. tostring(Players.MaxPlayers), bot = NAME,
					sent = nowMs(), seen = seenMs,
					pv_id = "G/" .. tostring(hit.rec.Uid or ""), pv_biome = pvZone(hit.rec.AreaId),
					pv_weight = tonumber(hit.weight), pv_scale = tonumber(hit.rec.AssetScale),
				}, 5)
				if code and code >= 200 and code < 300 then return end
				if code and code >= 400 and code < 500 and code ~= 429 then return end
				if attempt == 1 then task.wait(0.5) end
			end
		end)
		pending = pending - 1
	end)
end

