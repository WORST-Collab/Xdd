-- POST to the relay; gives up waiting after maxWait seconds (returns nil then)
local function relayPost(path, data, maxWait)
	if type(httpRequest) ~= "function" then return nil end
	local body = enc(data)
	if not body then return nil end
	local done, code, out = false, nil, nil
	task.spawn(function()
		local ok, res = pcall(httpRequest, {
			Url = RELAY .. path, Method = "POST",
			Headers = { ["Content-Type"] = "application/json", ["x-key"] = CONFIG.HUB_KEY },
			Body = body,
		})
		if ok and type(res) == "table" then code = tonumber(res.StatusCode or res.status) out = res.Body or res.body end
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < (maxWait or 5) do task.wait(0.03) end
	if not done then return nil end
	return code, out
end

